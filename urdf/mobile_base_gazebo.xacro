<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo reference="caster_front_wheel_link">
        <mu1 value="0.1" />
        <mu2 value="0.1" />
    </gazebo>

    <gazebo reference="caster_rear_wheel_link">
        <mu1 value="0.1" />
        <mu2 value="0.1" />
    </gazebo>

    <gazebo>
        <!-- Pengendali kecepatan roda kiri -->
        <plugin
            filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">

            <joint_name>base_left_wheel_joint</joint_name>
            <topic>/left_wheel/command</topic>

            <initial_velocity>0.0</initial_velocity>
            <use_force_commands>false</use_force_commands>
        </plugin>

        <!-- Pengendali kecepatan roda kanan -->
        <plugin
            filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">

            <joint_name>base_right_wheel_joint</joint_name>
            <topic>/right_wheel/command</topic>

            <initial_velocity>0.0</initial_velocity>
            <use_force_commands>false</use_force_commands>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>base_left_wheel_joint</joint_name>
            <joint_name>base_right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

</robot>